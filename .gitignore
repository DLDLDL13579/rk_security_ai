# ============================================================
# RK3588 智慧安防 AI 系统 · .gitignore
# 原则：代码 + 推理必需模型 + 测试素材入库；视频/权重/产物排除
# ============================================================

# ---- 测试视频与录制（体积大：1.4 G）----
*.mp4
*.avi
*.mkv
*.mov
videos/
videos_camera/
videos_multi/
data/videos/

# ---- 大模型权重（非推理必需）----
# 注意：推理必需的 .rknn 通过 ! 规则保留（见文件末尾）
*.pdiparams
*.pdmodel
*.pt
*.pth
*.mnn
*.nb

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 运行产物 ----
output/
outputs/
*.log
*.csv

# ---- 编辑器/系统 ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.bak
*.save

# ---- 运行缓存 ----
realtime/
**/output-img/

# ============================================================
# 例外：推理必需的模型必须入库（否则克隆后无法运行）
# ============================================================
!rk_pose_authoritative/models/*.rknn
!rk_pose_security/npu/*.rknn
!rk_pose_authoritative/models/*.onnx
